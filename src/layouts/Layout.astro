---
import '../styles/global.css';
import { sitePath } from '../utils/paths';
import { APP_STORE_PROVIDER_TOKEN, smartAppBannerContent } from '../data/campaigns';
import { FROZEN_PATHS, BRAND_NAME } from '../data/site';
import { ANALYTICS_BEACON_TOKEN, SEARCH_CONSOLE_VERIFICATION } from '../data/measurement';
import { APP_IMAGES, DEFAULT_IMAGE, PAGE_IMAGES } from '../data/seo';
import { absoluteUrl, serializeJsonLd, structuredData } from '../utils/structuredData';
import type { StoreTarget } from '../types/apps';
import type { PageFacts, PageSeo, SocialImage } from '../types/seo';

interface Props {
  title: string;
  description: string;
  banner: StoreTarget | null;
  seo?: PageSeo;
}

const { title, description, banner } = Astro.props;
const seo: PageSeo = Astro.props.seo ?? { kind: 'page' };
const beaconConfig: string = JSON.stringify({ token: ANALYTICS_BEACON_TOKEN });
const path: string = Astro.url.pathname;
const slashless: string = path.replace(/\/$/, '');
const frozen: boolean = FROZEN_PATHS.includes(slashless);
const canonicalUrl: string = absoluteUrl(frozen ? slashless : path);

function pageImage(): SocialImage {
  const byPath = PAGE_IMAGES[path];
  if (byPath !== undefined) return byPath;
  if (seo.kind === 'app') return APP_IMAGES[seo.app];
  if (banner !== null) return APP_IMAGES[banner.app];
  return DEFAULT_IMAGE;
}

const image: SocialImage = pageImage();
const imageUrl: string = absoluteUrl(image.path);
const facts: PageFacts = { path, title, description, image, seo };
const jsonLd: string = serializeJsonLd(structuredData(facts, canonicalUrl));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="512x512" href={sitePath('/favicon-512.png')} />
    <link rel="apple-touch-icon" href={sitePath('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#07090C" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content={SEARCH_CONSOLE_VERIFICATION} />
    {banner && <meta name="apple-itunes-app" content={smartAppBannerContent(banner, APP_STORE_PROVIDER_TOKEN)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={seo.kind === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    {seo.kind === 'notFound' ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    {!frozen && (
      <>
        <meta property="og:site_name" content={BRAND_NAME} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
        {seo.kind === 'article' && <meta property="article:published_time" content={seo.published} />}
        {seo.kind === 'article' && <meta property="article:modified_time" content={seo.modified} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={image.alt} />
        <script is:inline type="application/ld+json" set:html={jsonLd} />
      </>
    )}
  </head>
  <body>
    <slot />
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={beaconConfig}></script>
  </body>
</html>
