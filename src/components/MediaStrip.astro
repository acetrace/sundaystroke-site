---
import { sitePath } from '../utils/paths';
import type { MediaItem } from '../types/feature';

interface Props {
  media: readonly MediaItem[];
}

const { media } = Astro.props;
---
<div class="grid grid-cols-2 gap-4 md:grid-cols-4">
  {media.map((item) => (
    <figure class="flex flex-col gap-2">
      <img class="ss-media w-full" src={sitePath(item.src)} alt={item.alt} loading="lazy" width="600" />
      <figcaption class="ss-tag text-mist">{item.caption}</figcaption>
    </figure>
  ))}
</div>
