---
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---
<section class="border-t border-line bg-void py-20">
  <div class="container flex max-w-4xl flex-col gap-6">
    <h2 class="ss-display text-[30px] md:text-[44px]">{heading}</h2>
    <div class="flex max-w-2xl flex-col gap-4 text-body-lg text-mist">
      <slot />
    </div>
  </div>
</section>
