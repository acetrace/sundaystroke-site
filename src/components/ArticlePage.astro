---
import Layout from '../layouts/Layout.astro';
import NavBar from './NavBar.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHeading from './SectionHeading.astro';
import Prose from './Prose.astro';
import StoreCalls from './StoreCalls.astro';
import { AI_ASSISTED_NOTE, CONTENT_BYLINE } from '../data/site';
import { isoDate } from '../utils/dates';
import type { ArticleProps } from '../types/article';
import type { PageSeo } from '../types/seo';

type Props = ArticleProps;

const { pageTitle, description, eyebrow, heading, dates, banner, calls } = Astro.props;
const seo: PageSeo = dates === null
  ? { kind: 'collection' }
  : { kind: 'article', headline: heading, published: isoDate(dates.published), modified: isoDate(dates.modified) };
---
<Layout title={pageTitle} description={description} banner={banner} seo={seo}>
  <NavBar />
  <main class="ss-ground pb-24 pt-32 md:pt-36">
    <article class="container max-w-3xl">
      <header class="mb-10 flex flex-col gap-5">
        <span class="ss-eyebrow">{eyebrow}</span>
        <SectionHeading level="h1" text={heading} />
        {dates !== null && (
          <p class="ss-tag text-mist">
            By <span class="byline">{CONTENT_BYLINE}</span> · Published <time datetime={isoDate(dates.published)}>{dates.published}</time>
            {dates.modified !== dates.published && <> · Updated <time datetime={isoDate(dates.modified)}>{dates.modified}</time></>}
            · {AI_ASSISTED_NOTE}
          </p>
        )}
      </header>

      <Prose>
        <slot />
      </Prose>

      <StoreCalls calls={calls} />
    </article>
  </main>
  <SiteFooter />
</Layout>
