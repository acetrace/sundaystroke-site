---
import ArticlePage from './ArticlePage.astro';
import ComparisonTable from './ComparisonTable.astro';
import type { ComparisonPageProps } from '../types/comparison';

type Props = ComparisonPageProps;

const { pageTitle, description, heading, intro, advantages, table, checkedOn, methodSourceUrl, calls } = Astro.props;
---
<ArticlePage
  pageTitle={pageTitle}
  description={description}
  eyebrow="Compare"
  heading={heading}
  published={checkedOn}
  banner={null}
  calls={calls}
>
  <p>{intro}</p>

  <h2>Where SundayStroke comes out ahead</h2>
  <ul>
    {advantages.map((advantage) => <li>{advantage}</li>)}
  </ul>

  <h2>Side by side</h2>
  <ComparisonTable table={table} />

  <slot />

  <h2>How we compared</h2>
  <p>
    Checked on {checkedOn}. We read each app's US App Store listing on that day, and cross-checked download sizes and
    up-front prices through Apple's public <a href={methodSourceUrl}>App Store search service</a>. Every cell and every
    competitor fact links the page it came from. A feature a listing doesn't mention is recorded as not mentioned, which does not
    establish that the app lacks it. Prices are in US dollars as listed; they change, and they differ by country, so check the listing before
    you buy. One of the apps is ours, and we say so.
  </p>
</ArticlePage>
