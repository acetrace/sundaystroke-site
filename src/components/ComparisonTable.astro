---
import type { ComparedApp } from '../types/comparison';

interface Props {
  apps: readonly ComparedApp[];
}

const { apps } = Astro.props;
---
{apps.map((app) => (
  <section>
    <h3>{app.name}</h3>
    <p>{app.maker}</p>
    <ul>
      {app.facts.map((fact) => (
        <li>{fact.text} (source: <a href={fact.sourceUrl}>{fact.sourceLabel}</a>)</li>
      ))}
    </ul>
  </section>
))}
