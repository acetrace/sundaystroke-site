---
import type { ComparisonTableData } from '../types/comparison';

interface Props {
  table: ComparisonTableData;
}

const { table } = Astro.props;
---
<div class="overflow-x-auto">
  <table>
    <thead>
      <tr>
        <th></th>
        {table.apps.map((app, index) => <th class={index === 0 ? 'text-volt' : undefined}>{app}</th>)}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <tr>
          <th scope="row">{row.feature}</th>
          {row.cells.map((cell) => (
            <td class={cell.ours ? 'text-volt font-semibold' : undefined}>
              {cell.text} <a class="text-mist text-xs" href={cell.sourceUrl}>({cell.sourceLabel})</a>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
