---
import type { Highlight } from '../types/feature';

interface Props {
  highlights: readonly Highlight[];
}

const { highlights } = Astro.props;
---
<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
  {highlights.map((item) => (
    <article class="ss-card flex flex-col gap-3 p-6">
      <span class="ss-tag text-volt">{item.tag}</span>
      <h2 class="text-title-2 text-ice">{item.title}</h2>
      <p class="text-body text-mist">{item.body}</p>
    </article>
  ))}
</div>
