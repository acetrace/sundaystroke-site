---
import type { GolfGpsStep } from '../types/golfGps';

interface Props {
  steps: readonly GolfGpsStep[];
}

const { steps } = Astro.props;
---
<ol class="flex flex-col gap-5">
  {steps.map((step, index) => (
    <li class="flex gap-4">
      <span class="ss-tag pt-1 text-volt">{String(index + 1).padStart(2, '0')}</span>
      <div class="flex flex-col gap-1">
        <h3 class="text-title-3 font-semibold text-ice">{step.title}</h3>
        <p class="text-body-lg text-mist">{step.body}</p>
      </div>
    </li>
  ))}
</ol>
