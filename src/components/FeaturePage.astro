---
import Layout from '../layouts/Layout.astro';
import NavBar from './NavBar.astro';
import SiteFooter from './SiteFooter.astro';
import StoreButtons from './StoreButtons.astro';
import HighlightGrid from './HighlightGrid.astro';
import PlanColumns from './PlanColumns.astro';
import MediaStrip from './MediaStrip.astro';
import type { FeaturePageProps } from '../types/feature';

type Props = FeaturePageProps;

const { pageTitle, description, eyebrow, headline, accent, lead, target, highlights, plans, media } = Astro.props;
---
<Layout title={pageTitle} description={description} banner={target}>
  <NavBar />
  <main>
    <section class="ss-ground pb-20 pt-36 md:pt-44">
      <div class="container flex max-w-4xl flex-col items-start gap-7">
        <span class="ss-eyebrow">{eyebrow}</span>
        <h1 class="ss-display text-[38px] sm:text-[56px] lg:text-[72px]">
          {headline}<br /><span class="ss-accent">{accent}</span>
        </h1>
        <p class="max-w-2xl text-body-lg text-mist">{lead}</p>
        <StoreButtons target={target} />
      </div>
    </section>

    {media.length > 0 && (
      <section class="border-t border-line bg-void py-16">
        <div class="container max-w-5xl">
          <MediaStrip media={media} />
        </div>
      </section>
    )}

    <section class="border-t border-line bg-void py-20">
      <div class="container max-w-5xl">
        <HighlightGrid highlights={highlights} />
      </div>
    </section>

    {plans.length > 0 && (
      <section class="border-t border-line bg-void py-20">
        <div class="container flex max-w-5xl flex-col gap-8">
          <h2 class="ss-display text-[30px] md:text-[44px]">What's free</h2>
          <PlanColumns plans={plans} />
        </div>
      </section>
    )}

    <slot />
  </main>
  <SiteFooter />
</Layout>
