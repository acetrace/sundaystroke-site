---
import Layout from '../layouts/Layout.astro';
import NavBar from './NavBar.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHeading from './SectionHeading.astro';
import Prose from './Prose.astro';

interface Props {
  pageTitle: string;
  description: string;
  eyebrow: string;
  heading: string;
}

const { pageTitle, description, eyebrow, heading } = Astro.props;
---
<Layout title={pageTitle} description={description} banner={null}>
  <NavBar />
  <main class="ss-ground pb-24 pt-32 md:pt-36">
    <div class="container max-w-3xl">
      <div class="mb-10 flex flex-col gap-5">
        <span class="ss-eyebrow">{eyebrow}</span>
        <SectionHeading level="h1" text={heading} />
      </div>

      <Prose>
        <slot />
      </Prose>
    </div>
  </main>
  <SiteFooter />
</Layout>
