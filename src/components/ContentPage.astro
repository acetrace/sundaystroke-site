---
import Layout from '../layouts/Layout.astro';
import NavBar from './NavBar.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  pageTitle: string;
  description: string;
  eyebrow: string;
  heading: string;
}

const { pageTitle, description, eyebrow, heading } = Astro.props;
---
<Layout title={pageTitle} description={description}>
  <NavBar />
  <main class="ss-ground pb-24 pt-32 md:pt-36">
    <div class="container max-w-3xl">
      <div class="mb-10 flex flex-col gap-5">
        <span class="ss-eyebrow">{eyebrow}</span>
        <SectionHeading level="h1" text={heading} />
      </div>

      <div class="prose prose-invert max-w-none
        prose-headings:font-display prose-headings:font-extrabold prose-headings:uppercase prose-headings:tracking-[0.01em] prose-headings:text-ice
        prose-h2:text-sheet-title prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-title-3 prose-h3:font-sans prose-h3:normal-case prose-h3:tracking-normal prose-h3:font-semibold
        prose-p:text-body prose-p:text-mist
        prose-strong:text-ice prose-strong:font-semibold
        prose-a:text-volt prose-a:no-underline hover:prose-a:underline
        prose-li:text-body prose-li:text-mist prose-li:marker:text-volt
        prose-th:text-ice prose-td:text-mist prose-td:align-top">
        <slot />
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
