---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StoreButtons from '../components/StoreButtons.astro';
import ClipPair from '../components/ClipPair.astro';
import Prose from '../components/Prose.astro';
import { sitePath } from '../utils/paths';
import { GOLF_GPS_SITE_URL } from '../data/site';
import type { AppCard } from '../types/hub';
import type { NavLink } from '../types/navigation';
import type { Clip } from '../types/tutorial';

const APP_CARDS: readonly AppCard[] = [
  {
    target: { app: 'tracer', campaign: 'web-tracer-hub' },
    href: sitePath('/tracer/'),
    linkLabel: 'Meet Tracer',
    eyebrow: 'Golf and disc golf',
    title: 'Tracer',
    body: 'Film a swing or a throw, and Tracer draws the flight of the ball or disc onto your video. Select the golf ball once and it follows the flight; in Free curve it follows a disc from release. No tripod needed.',
    image: '/media/learn/golf-result.jpg',
    imageAlt: 'A golf swing with the ball flight drawn by Tracer',
  },
  {
    target: { app: 'golfGps', campaign: 'web-gps-hub' },
    href: sitePath('/golf-gps/'),
    linkLabel: 'Meet Golf GPS',
    eyebrow: 'On the course',
    title: 'Golf GPS',
    body: 'Free yardages to the front, center and back of the green on a satellite map, a movable layup target and a scorecard that saves every round. No ads. Golf GPS Pro adds an estimated handicap, stats and shot tracking.',
    image: '/media/golf-gps/03-map-distance.jpg',
    imageAlt: 'Golf GPS showing the yardage to the green on a satellite map',
  },
];

const TASKS: readonly (readonly [string, string, string])[] = [
  ['Show the flight of a golf ball on your video', 'Tracer', '/tracer/'],
  ['Trace a disc golf drive or putt', 'Tracer', '/tracer/disc-golf/'],
  ['See front, center and back yardages to the green', 'Golf GPS', '/golf-gps/'],
  ['Plan a layup short of a hazard', 'Golf GPS', '/golf-gps/'],
  ['Keep score and save every round', 'Golf GPS', '/golf-gps/scorecard/'],
  ['Follow an estimated handicap over time', 'Golf GPS Pro', '/golf-gps/handicap/'],
];

const TRACER_CLIPS: readonly Clip[] = [
  { src: '/media/learn/golf-original.mp4', poster: '/media/learn/golf-original.jpg', label: 'Before: the swing as filmed' },
  { src: '/media/learn/golf-result.mp4', poster: '/media/learn/golf-result.jpg', label: 'After: the flight traced by Tracer' },
];

const GUIDES: readonly NavLink[] = [
  { href: sitePath('/learn/'), label: 'Tracer tutorials: film a golf ball flight, film a disc flight and fix a trace by hand' },
  { href: sitePath('/golf-handicap/'), label: 'How a golf handicap is calculated, with worked examples' },
  { href: sitePath('/golf-handicap/calculator/'), label: 'Golf handicap calculator for your 18-hole rounds' },
  { href: sitePath('/compare/tracer/'), label: 'Golf ball tracer apps compared' },
  { href: sitePath('/compare/golf-gps/'), label: 'Free golf GPS apps compared' },
  { href: sitePath('/sunday/'), label: 'The Sunday post, a short weekly read' },
];
---
<Layout
  title="SundayStroke | Tracer & Golf GPS Apps for iPhone"
  description="Meet SundayStroke's two iPhone apps: add golf and disc flight lines to your videos with Tracer, or get free yardages and keep score with Golf GPS."
  banner={null}
  seo={{ kind: 'home' }}
>
  <NavBar />
  <main>
    <section class="ss-ground pb-16 pt-36 md:pt-44">
      <div class="container flex max-w-4xl flex-col items-start gap-7">
        <span class="ss-eyebrow">SundayStroke · Play it. Share it.</span>
        <h1 class="ss-display text-[38px] sm:text-[56px] lg:text-[72px]">
          Golf and disc golf<br /><span class="ss-accent">apps for iPhone.</span>
        </h1>
        <p class="max-w-2xl text-body-lg text-mist">
          Two apps for the golfer who plays on Sunday. Tracer draws the flight of your ball or disc onto the videos you film.
          Golf GPS gives you the yardage to the green and keeps your scorecard. Each is its own free download on the App Store.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-void py-20">
      <div class="container flex max-w-5xl flex-col gap-10">
        <h2 class="ss-display text-[30px] md:text-[44px]">Two iPhone apps for your round</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {APP_CARDS.map((card) => (
            <article class="ss-card flex flex-col gap-5 p-6">
              <a href={card.href} class="block">
                <img class="ss-media aspect-[4/5] w-full object-cover" src={sitePath(card.image)} alt={card.imageAlt} loading="lazy" width="600" />
              </a>
              <span class="ss-tag text-volt">{card.eyebrow}</span>
              <h3 class="ss-display text-[30px] md:text-[40px]"><a href={card.href}>{card.title}</a></h3>
              <p class="text-body text-mist">{card.body}</p>
              <div class="flex flex-wrap items-center gap-4">
                <a href={card.href} class="ss-btn ss-btn--secondary">{card.linkLabel}</a>
                <StoreButtons target={card.target} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-void py-20">
      <div class="container max-w-4xl">
        <Prose>
          <h2>Which SundayStroke app do you need?</h2>
          <p>Pick by what you want to do. Many golfers use both: Golf GPS during the round, Tracer for the clips afterwards.</p>
          <div class="overflow-x-auto">
            <table>
              <thead><tr><th>You want to</th><th>Use</th></tr></thead>
              <tbody>
                {TASKS.map(([task, app, href]) => (
                  <tr><td>{task}</td><td><a href={sitePath(href)}>{app}</a></td></tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2>See Tracer before and after</h2>
          <p>
            A real swing from the app. In Trace golf you put the cursor on the ball at the start of the flight and Tracer follows it.
            If the line slips, move the landing point and the arc by hand, or trim the frames it shouldn't follow. Stabilization keeps
            the line in place when the phone moves, so you can film handheld.
          </p>
          <ClipPair clips={TRACER_CLIPS} />
          <p>
            Then choose the look: a single color or a gradient, the width, a 3D line, and a distance label you type in that counts up
            while the ball flies. Save to Photos and share. The free version includes automatic tracking and some saves with a small
            watermark; Premium removes the watermark and adds more styles and effects.
          </p>

          <h2>Golf GPS on the course</h2>
          <p>
            Open Golf GPS and it finds the courses near you. On each hole you see a satellite map with yardages to the front, center
            and back of the green. Drag the Target to plan a layup: the app shows how far it is from you and how far it leaves you
            from the green. Tap plus or minus to enter your strokes; totals and your score against par update as you go, and every
            round is saved. Golf GPS also has its own site at <a href={GOLF_GPS_SITE_URL}>golfgps.ai</a>.
          </p>

          <h2>Start with a practical guide</h2>
          <ul>
            {GUIDES.map((guide) => <li><a href={guide.href}>{guide.label}</a></li>)}
          </ul>

          <h2>Questions</h2>
          <h3>Are Tracer and Golf GPS one app?</h3>
          <p>No. Tracer edits your videos; Golf GPS helps you during a round. Each has its own App Store download.</p>
          <h3>Are they free?</h3>
          <p>
            Both are free to download. Tracer is free to try, with Premium for unlimited saves without a watermark. Golf GPS gives you
            yardages and the scorecard for free, with no ads; Golf GPS Pro adds an estimated handicap, stats and shot tracking.
          </p>
          <h3>Do they work for disc golf?</h3>
          <p>Tracer does: its Free curve mode follows a disc once you select it at release. Golf GPS is for golf courses.</p>
          <h3>Who makes SundayStroke?</h3>
          <p>SundayStroke apps are made by Ivkin Labs LLC for iPhone.</p>
        </Prose>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
