---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { sitePath } from '../utils/paths';
import type { AppCard } from '../types/hub';
import type { NavLink } from '../types/navigation';

const APP_CARDS: readonly AppCard[] = [
  {
    target: { app: 'tracer', campaign: 'web-tracer-hub' },
    href: sitePath('/tracer/'),
    linkLabel: 'Meet Tracer',
    eyebrow: 'Golf and disc golf',
    title: 'Tracer',
    body: 'Film your swing or your throw, and Tracer draws the flight of the ball or disc onto your video.',
    image: '/media/learn/golf-result.jpg',
    imageAlt: 'A golf swing with the ball flight drawn by Tracer',
  },
  {
    target: { app: 'golfGps', campaign: 'web-gps-hub' },
    href: sitePath('/golf-gps/'),
    linkLabel: 'Meet Golf GPS',
    eyebrow: 'On the course',
    title: 'Golf GPS',
    body: 'Yardages to the green on a satellite map and a scorecard that keeps itself. Golf GPS Pro adds your handicap and stats.',
    image: '/media/golf-gps/03-map-distance.jpg',
    imageAlt: 'Golf GPS showing the yardage to the green on a satellite map',
  },
];

const READS: readonly NavLink[] = [
  { href: sitePath('/learn/'), label: 'Tracer tutorials' },
  { href: sitePath('/golf-handicap/'), label: 'How a golf handicap works' },
  { href: sitePath('/golf-handicap/calculator/'), label: 'Handicap calculator' },
  { href: sitePath('/sunday/'), label: 'The Sunday post' },
];
---
<Layout
  title="SundayStroke · Golf apps for iPhone: Tracer and Golf GPS"
  description="SundayStroke makes golf apps for iPhone: Tracer draws the flight of your ball or disc onto your videos, and Golf GPS gives you yardages and a scorecard."
  banner={null}
>
  <NavBar />
  <main>
    <section class="ss-ground pb-16 pt-36 md:pt-44">
      <div class="container flex max-w-4xl flex-col items-start gap-7">
        <span class="ss-eyebrow">SundayStroke · Golf apps for iPhone</span>
        <h1 class="ss-display text-[38px] sm:text-[56px] lg:text-[72px]">
          Play it.<br /><span class="ss-accent">Share it.</span>
        </h1>
        <p class="max-w-2xl text-body-lg text-mist">
          Two apps for the golfer who plays on Sunday: Tracer draws the flight of your ball or disc onto your video,
          and Golf GPS gives you the yardage and keeps your score.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-void py-20">
      <div class="container grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-2">
        {APP_CARDS.map((card) => (
          <article class="ss-card flex flex-col gap-5 p-6">
            <a href={card.href} class="block">
              <img class="ss-media aspect-[4/5] w-full object-cover" src={sitePath(card.image)} alt={card.imageAlt} loading="lazy" width="600" />
            </a>
            <span class="ss-tag text-volt">{card.eyebrow}</span>
            <h2 class="ss-display text-[30px] md:text-[40px]"><a href={card.href}>{card.title}</a></h2>
            <p class="text-body text-mist">{card.body}</p>
            <div class="flex flex-wrap items-center gap-4">
              <a href={card.href} class="ss-btn ss-btn--secondary">{card.linkLabel}</a>
              <StoreButtons target={card.target} />
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-line bg-void py-20">
      <div class="container flex max-w-4xl flex-col gap-6">
        <h2 class="ss-display text-[30px] md:text-[44px]">Read and learn</h2>
        <ul class="flex flex-col gap-3 text-body-lg">
          {READS.map((link) => (
            <li><a class="text-volt" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
