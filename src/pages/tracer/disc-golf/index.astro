---
import FeaturePage from '../../../components/FeaturePage.astro';
import PageSection from '../../../components/PageSection.astro';
import Prose from '../../../components/Prose.astro';
import ClipPair from '../../../components/ClipPair.astro';
import TracerFaqList from '../../../components/TracerFaqList.astro';
import { sitePath } from '../../../utils/paths';
import type { Highlight, MediaItem } from '../../../types/feature';
import type { Clip, FaqItem, TroubleshootingItem } from '../../../types/tutorial';

const HIGHLIGHTS: readonly Highlight[] = [
  {
    tag: 'Free curve',
    title: 'Follows your disc',
    body: 'Select the disc at release and Tracer can follow it through the flight. Add or move key points wherever the line drifts.',
  },
  {
    tag: 'Any throw',
    title: 'Drives to putts',
    body: 'Hyzers, anhyzers, rollers, upshots and putts: if you can see the disc in the video, you can draw its line.',
  },
  {
    tag: 'Phone only',
    title: 'No tripod, no computer',
    body: 'Film in your hands or with the phone leaning on your bag, trace it in the app and post it before the next tee.',
  },
];

const MEDIA: readonly MediaItem[] = [
  { src: '/media/learn/disc-golf-flight.jpg', alt: 'A disc golf throw with its whole flight drawn from release to landing', caption: 'The whole flight' },
  { src: '/media/learn/disc-golf-result.jpg', alt: 'A disc golf throw with the disc flight drawn', caption: 'Traced throw' },
  { src: '/media/learn/disc-golf-editing.jpg', alt: 'Adding key points along the disc flight in Free curve', caption: 'Adding points' },
];

const DISC_CLIPS: readonly Clip[] = [
  { src: '/media/learn/disc-golf-result.mp4', poster: '/media/learn/disc-golf-result.jpg', label: 'The traced disc flight' },
];

const EDITING_CLIPS: readonly Clip[] = [
  { src: '/media/learn/disc-golf-editing.mp4', poster: '/media/learn/disc-golf-editing.jpg', label: 'Placing key points along the flight' },
];

const FIXES: readonly TroubleshootingItem[] = [
  { problem: 'The line cuts inside the turn', cause: 'No point at the widest part', fix: 'Add a key point on the disc where the turn is widest' },
  { problem: 'The line hooks too early', cause: 'The fade point is on the wrong frame', fix: 'Move it to the frame where the disc starts to fade' },
  { problem: 'The line follows a bird or branch', cause: 'Something crossed the disc', fix: 'Add or move key points on the disc where the line left it' },
  { problem: 'The line jumps suddenly', cause: 'The stabilization type may not suit the clip', fix: 'Try changing stabilization from Smart to Fast in Settings' },
];

const FAQS: readonly FaqItem[] = [
  {
    question: 'Does Tracer follow a disc automatically?',
    answer: 'Yes, in Free curve. Select the disc at release and Tracer can follow it. You add or move key points by hand where the line drifts.',
  },
  {
    question: 'Can it trace a disc hidden by a tree?',
    answer: 'You can hide the section of the line that passes behind an obstacle using Effects > Color segments and the clear style. Any flight drawn through an unseen section is your estimate.',
  },
  {
    question: 'Do I need a tripod?',
    answer: 'No. Hold the phone or lean it on your bag. The line stays in place when the camera moves.',
  },
  {
    question: 'Can I show how far the throw went?',
    answer: 'Yes, with Premium. Type the distance under Effects > Distance and a counter runs up during the flight. Tracer does not measure it, so use a number you measured separately.',
  },
  {
    question: 'Is it free?',
    answer: 'Free curve and the disc tracking are free, with the Floodlit and white lines and some free saves with a small watermark. Premium adds unlimited saves with no watermark, more styles, the effects, color segments and the distance label.',
  },
];
---
<FeaturePage
  pageTitle="Disc Golf Tracer App for iPhone | SundayStroke"
  description="Add a flight line to disc golf videos on iPhone. Free curve follows the disc after you select it at release; add or move key points, then style and save."
  eyebrow="SundayStroke Tracer · Disc golf"
  headline="Disc golf tracer"
  accent="for your iPhone videos."
  lead="Film your throw, select the disc at release, and Tracer follows it through the flight. Add or move key points by hand wherever the line drifts."
  target={{ app: 'tracer', campaign: 'web-tracer-discgolf' }}
  highlights={HIGHLIGHTS}
  plans={[]}
  media={MEDIA}
>
  <PageSection heading="Watch a traced disc flight">
    <Prose>
      <p>
        A real throw traced in the app. The line shows the path of the
        throw from release to landing.
      </p>
      <ClipPair clips={DISC_CLIPS} />
    </Prose>
  </PageSection>

  <PageSection heading="How Free curve follows a disc's changing flight">
    <Prose>
      <p>
        Disc throws use Free curve rather than the golf mode. Tap Free curve on the home screen, pick your throw,
        scroll to the frame just after release and select the disc with the cursor. Tracer can follow it from there.
      </p>
      <h3>Mark release, turns and landing</h3>
      <p>
        Watch the playback. Where the line leaves the disc, add a key point on it. Start with a few useful points, such as just after release,
        a clear change of direction and the landing, and add more only where the visible flight needs them.
      </p>
      <ClipPair clips={EDITING_CLIPS} />
      <h3>Adjust points when the line drifts</h3>
      <table>
        <thead><tr><th>What you see</th><th>Why</th><th>What to do</th></tr></thead>
        <tbody>
          {FIXES.map((fix) => <tr><td>{fix.problem}</td><td>{fix.cause}</td><td>{fix.fix}</td></tr>)}
        </tbody>
      </table>
      <p>The full walkthrough is in <a href={sitePath('/learn/film-a-disc-flight/')}>how to trace a disc golf flight on iPhone</a>.</p>
    </Prose>
  </PageSection>

  <PageSection heading="Drives, approaches and putts">
    <Prose>
      <ul>
        <li><strong>Drives:</strong> film from 3 to 5 meters behind the tee pad, a step to the side of the run-up. Keep the release and as much of the flight as you can in frame.</li>
        <li><strong>Approaches:</strong> film from the side, roughly level with the peak, to show height and the release angle.</li>
        <li><strong>Putts:</strong> film from behind the putter or beside the basket, with both release and chains in the frame. Two or three points are enough.</li>
      </ul>
    </Prose>
  </PageSection>

  <PageSection heading="Film handheld and keep the flight visible">
    <Prose>
      <p>
        No tripod needed. Hold the phone in both hands with your elbows tucked, or lean it on your bag. The line stays in place when the camera
        moves.
      </p>
      <ul>
        <li>Use the 1x lens. The 0.5x lens makes the disc tiny in the air.</li>
        <li>Lock focus and exposure by touching and holding on the tee pad before the throw.</li>
        <li>Throw a bright disc: orange, pink and yellow stand out against trees; white disappears against cloud.</li>
        <li>Keep recording until the disc lands.</li>
      </ul>
      <p>
        On your own on the course? <a href={sitePath('/learn/add-tracer-to-disc-golf-video/')}>How to film disc golf on iPhone when playing solo</a> covers
        where to prop the phone for each kind of throw.
      </p>
    </Prose>
  </PageSection>

  <PageSection heading="Finish the line behind trees and obstacles">
    <Prose>
      <p>
        When the disc passes behind a trunk, Effects > Color segments with the clear style (Premium) makes that section of the line transparent.
        Place a key point where the disc goes behind and one where it comes out, then hide the part in between. See <a href={sitePath('/learn/trace-behind-trees/')}>how to show a flight behind trees</a>.
      </p>
    </Prose>
  </PageSection>

  <PageSection heading="Style the line and add a distance">
    <Prose>
      <p>
        Choose a color that stands out from the trees and sky, set the width and turn on the 3D look. With Premium, add a
        gradient, electricity or wave effects, a tail length or a landing effect. To show how far the throw went, type the distance under Effects &gt; Distance, also with
        Premium, and a counter runs up as the disc flies. Then save to Photos and post.
      </p>
    </Prose>
  </PageSection>

  <PageSection heading="Free access, Premium and common questions">
    <Prose>
      <TracerFaqList faqs={FAQS} />
      <p>
        Golf too: see <a href={sitePath('/tracer/')}>Tracer for golf</a>. For every button and gesture, see the
        <a href={sitePath('/manual-tracing')}>manual tracing reference</a>.
      </p>
    </Prose>
  </PageSection>
</FeaturePage>
