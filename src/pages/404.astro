---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { sitePath } from '../utils/paths';
---
<Layout title="Page not found · SundayStroke" description="Page not found." banner={null}>
  <NavBar />
  <main class="ss-ground flex min-h-[80vh] flex-col items-center justify-center gap-7 px-5 pb-24 pt-36 text-center">
    <span class="ss-eyebrow">Out of bounds · 404</span>
    <SectionHeading level="h1" text="Page not found" />
    <p class="max-w-md text-body-lg text-mist">This page doesn't exist. Head back to the start and try again.</p>
    <a href={sitePath('/')} class="ss-btn ss-btn--primary">Back to SundayStroke</a>
  </main>
  <SiteFooter />
</Layout>
