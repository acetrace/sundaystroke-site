---
import ArticlePage from '../../components/ArticlePage.astro';
import { SUNDAY_ISSUES } from '../../data/sunday';
import { sitePath } from '../../utils/paths';
import { SUNDAY_CALLS } from '../../data/storeCalls';

---
<ArticlePage
  pageTitle="The Sunday post · SundayStroke"
  description="Golf and disc golf stories, practical playing ideas and SundayStroke app updates. Browse every issue of The Sunday post."
  eyebrow="The Sunday post"
  heading="The Sunday post"
  dates={null}
  banner={null}
  calls={SUNDAY_CALLS}
>
  <p>The Sunday post brings together golf and disc golf stories, a practical idea for your next round and an update from SundayStroke. Browse the issues below.</p>
  <h2>Issues</h2>
  <ul>
    {SUNDAY_ISSUES.map((issue) => (
      <li><a href={sitePath(`/sunday/${issue.slug}/`)}>Issue {issue.number}, {issue.date}</a>: {issue.summary}</li>
    ))}
  </ul>
</ArticlePage>
